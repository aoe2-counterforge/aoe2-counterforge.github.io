# Where Age of Empires II is installed: the folder holding resources/ and widgetui/.
# Only the extraction scripts read it; the application itself ships with the data.
AOE2_GAME_ROOT="C:/Program Files (x86)/Steam/steamapps/common/AoE2DE"

# The browser Playwright drives for `npm run test:e2e` and `npm run docs:screenshots`: any
# Chromium-based one. Left unset, Windows uses the Edge it ships with and everywhere else uses the
# Chromium `npx playwright install chromium` leaves behind.
# PLAYWRIGHT_BROWSER="C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe"
